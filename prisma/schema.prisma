datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// -------------------------------------------------------------
// 1. IDENTITY & RBAC
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("LISTING_EXECUTIVE") // SUPER_ADMIN, ADMIN_MANAGER, SALES_MANAGER, LISTING_EXECUTIVE
  avatar       String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads Lead[]       @relation("AssignedLeads")
  quotations    Quotation[]
  auditLogs     AuditLog[]
}

model Customer {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String?
  isVerified   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses      Address[]
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  returnRequests ReturnRequest[]
}

model Address {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String   @default("HOME") // HOME, WORK, OTHER
  recipientName String
  phone         String
  streetAddress String
  landmark      String?
  city          String
  state         String
  pincode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  action    String   // CREATE, UPDATE, DELETE, APPROVE, REJECT, EXPORT
  entity    String   // PRODUCT, ORDER, SUPPLIER, MARGIN, LEAD
  entityId  String?
  details   String?  // JSON formatted details
  ipAddress String?
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 2. CATALOG & TAXONOMY
// -------------------------------------------------------------

model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  description  String?
  image        String?
  icon         String?
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  subcategories Subcategory[]
  products     Product[]
  marginRule   CategoryMarginRule?
  createdAt    DateTime      @default(now())
}

model Subcategory {
  id           String    @id @default(uuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  modelNumber        String?
  sku                String   @unique
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  subcategoryId      String
  subcategory        Subcategory @relation(fields: [subcategoryId], references: [id])
  brandId            String
  brand              Brand    @relation(fields: [brandId], references: [id])
  
  shortDescription   String?
  fullDescription    String?
  
  mrp                Float
  purchasePrice      Float    // Visible only to authorized roles
  sellingPrice       Float
  discountPercent    Float    @default(0)
  gstPercent         Float    @default(18)
  
  stock              Int      @default(0)
  lowStockThreshold  Int      @default(5)
  
  isFeatured         Boolean  @default(false)
  isTrending         Boolean  @default(false)
  isBestSeller       Boolean  @default(false)
  isNewArrival       Boolean  @default(false)
  
  // Listing Approval Workflow: DRAFT -> SUBMITTED -> UNDER_REVIEW -> APPROVED -> PUBLISHED / REJECTED
  status             String   @default("PUBLISHED") 
  rejectionReason    String?
  
  warrantyMonths     Int      @default(12)
  warrantyDetails    String?
  
  installationType   String   @default("NOT_REQUIRED") // FREE, PAID, NOT_REQUIRED
  installationCost   Float    @default(0)
  
  deliveryChargeType String   @default("FREE") // FREE, FLAT, LOCATION_BASED
  flatDeliveryCharge Float    @default(0)
  
  returnPolicyDays   Int      @default(7)
  
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  images             ProductImage[]
  attributes         ProductAttribute[]
  reviews            Review[]
  orderItems         OrderItem[]
  supplierProducts   SupplierProduct[]
  wishlistItems      WishlistItem[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
}

model ProductAttribute {
  id             String  @id @default(uuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName  String  // Screen Size, Capacity, Star Rating, Color, Material, etc.
  attributeValue String  // 55 inch, 1.5 Ton, 5 Star, Walnut, etc.
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int      // 1 to 5
  reviewTitle        String?
  reviewText         String
  images             String?  // JSON array of image URLs
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// -------------------------------------------------------------
// 3. SOURCING & SUPPLIER MANAGEMENT
// -------------------------------------------------------------

model Supplier {
  id           String   @id @default(uuid())
  name         String
  companyName  String
  phone        String
  whatsapp     String?
  email        String?
  gstin        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  deliveryArea String?  // Local, Pan-India, North Zone
  paymentTerms String?  // 30 Days, Immediate, 50% Advance
  returnTerms  String?
  rating       Float    @default(4.5)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  suppliedProducts SupplierProduct[]
  assignedOrders   Order[]
}

model SupplierProduct {
  id                String   @id @default(uuid())
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku       String?
  purchasePrice     Float
  stock             Int      @default(0)
  leadTimeDays      Int      @default(2)
  isPrimarySupplier Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@unique([supplierId, productId])
}

// -------------------------------------------------------------
// 4. PRICING & MARGIN RULES
// -------------------------------------------------------------

model CategoryMarginRule {
  id                   String   @id @default(uuid())
  categoryId           String   @unique
  category             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  minMarginPercent     Float    @default(10)
  defaultMarginPercent Float    @default(15)
  otherCostPercent     Float    @default(3) // Shipping, packaging, payment gateway costs
  notes                String?
  updatedAt            DateTime @updatedAt
}

// -------------------------------------------------------------
// 5. ORDERS, SHIPMENTS & FULFILMENT
// -------------------------------------------------------------

model Order {
  id                   String   @id @default(uuid())
  orderNumber          String   @unique
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  customerName         String
  customerPhone        String
  customerEmail        String
  
  shippingAddressText  String
  billingAddressText   String?
  pincode              String
  
  totalMrp             Float
  subtotal             Float
  totalDiscount        Float    @default(0)
  couponCode           String?
  couponDiscount       Float    @default(0)
  deliveryCharge       Float    @default(0)
  installationCharge   Float    @default(0)
  gstAmount            Float
  grandTotal           Float
  
  paymentStatus        String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod        String   @default("RAZORPAY") // RAZORPAY, UPI, CARD, NETBANKING, COD, EMI
  razorpayOrderId      String?
  razorpayPaymentId    String?
  
  // Lifecycle: PENDING -> CONFIRMED -> SUPPLIER_PROCESSING -> PACKED -> SHIPPED -> OUT_FOR_DELIVERY -> DELIVERED (or CANCELLED, RETURNED, REFUNDED)
  orderStatus          String   @default("CONFIRMED")
  
  // Fulfilment Model: SUPPLIER_TO_CUSTOMER, SUPPLIER_WAREHOUSE_CUSTOMER, LOCAL_SUPPLIER_LOCAL_DELIVERY
  fulfilmentModel      String   @default("LOCAL_SUPPLIER_LOCAL_DELIVERY")
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  invoiceNumber        String?  @unique
  notes                String?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items                OrderItem[]
  shipments            Shipment[]
  returnRequests       ReturnRequest[]
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  productName          String
  productSku           String
  productImage         String?
  quantity             Int      @default(1)
  unitMrp              Float
  unitSellingPrice     Float
  unitPurchaseCost     Float    // For gross margin calculation
  unitGstPercent       Float    @default(18)
  total                Float
  installationRequired Boolean  @default(false)
  installationCost     Float    @default(0)
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber    String?
  courierName       String?
  trackingUrl       String?
  status            String    @default("MANIFESTED") // MANIFESTED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
}

model PincodeService {
  id                     String  @id @default(uuid())
  pincode                String  @unique
  city                   String
  state                  String
  isDeliverable          Boolean @default(true)
  deliveryCharge         Float   @default(0)
  estimatedDays          Int     @default(2)
  isCodAvailable         Boolean @default(true)
  isInstallationAvailable Boolean @default(true)
}

// -------------------------------------------------------------
// 6. MARKETING & OFFERS
// -------------------------------------------------------------

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  description       String?
  discountType      String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue     Float
  minOrderAmount    Float    @default(0)
  maxDiscountAmount Float?
  usageLimit        Int      @default(1000)
  usageCount        Int      @default(0)
  startDate         DateTime @default(now())
  endDate           DateTime
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Campaign {
  id              String   @id @default(uuid())
  title           String   // Diwali Sale, Wedding Special, Monsoon Mega Offer
  slug            String   @unique
  tagline         String?
  bannerUrl       String?
  mobileBannerUrl String?
  discountText    String?
  ctaText         String   @default("EXPLORE OFFERS")
  ctaLink         String   @default("/deals")
  startDate       DateTime @default(now())
  endDate         DateTime
  isActive        Boolean  @default(true)
}

// -------------------------------------------------------------
// 7. SALES CRM & LEADS
// -------------------------------------------------------------

model Lead {
  id                String   @id @default(uuid())
  name              String
  phone             String
  email             String?
  city              String?
  leadSource        String   @default("GET_BEST_PRICE") // WEBSITE_PRODUCT, GET_BEST_PRICE, WHATSAPP, WEDDING_PACKAGE, B2B_CORPORATE, DIRECT
  productName       String?
  quantity          Int      @default(1)
  budgetRange       String?
  requirement       String?
  
  // Pipeline: NEW -> CONTACTED -> INTERESTED -> QUOTATION -> NEGOTIATION -> WON -> LOST
  status            String   @default("NEW")
  assignedToId      String?
  assignedTo        User?    @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  lostReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities        LeadActivity[]
  quotations        Quotation[]
}

model LeadActivity {
  id            String   @id @default(uuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String   // CALL, WHATSAPP, EMAIL, NOTE, STATUS_CHANGE
  summary       String
  details       String?
  conductedBy   String?
  createdAt     DateTime @default(now())
}

model Quotation {
  id                 String   @id @default(uuid())
  quoteNumber        String   @unique
  leadId             String?
  lead               Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  customerEmail      String?
  subtotal           Float
  discount           Float    @default(0)
  gstAmount          Float
  deliveryCharge     Float    @default(0)
  installationCharge Float    @default(0)
  totalAmount        Float
  
  // Status: DRAFT, SENT, VIEWED, NEGOTIATION, ACCEPTED, REJECTED, EXPIRED
  status             String   @default("DRAFT")
  validityDate       DateTime
  terms              String?
  
  createdById        String?
  createdBy          User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pdfUrl             String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productName String
  productSku  String?
  quantity    Int       @default(1)
  unitPrice   Float
  discount    Float     @default(0)
  total       Float
}

// -------------------------------------------------------------
// 8. WEDDING PACKAGE & B2B
// -------------------------------------------------------------

model WeddingPackage {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  budgetTier     String   // 1_LAKH, 2_LAKH, 3_LAKH, 5_LAKH, 10_LAKH_PLUS
  headline       String?
  basePrice      Float
  packagePrice   Float
  discountAmount Float
  description    String?
  bannerImage    String?
  isFeatured     Boolean  @default(true)
  isActive       Boolean  @default(true)
  itemsJson      String   // JSON list of default bundled products & items
  createdAt      DateTime @default(now())
}

model B2BEnquiry {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  phone         String
  email         String
  city          String
  businessType  String   // Hotel, Office, Builder, Hospital, Restaurant, School, Institution
  products      String
  quantity      Int
  requirement   String?
  status        String   @default("PENDING") // PENDING, CONTACTED, CONVERTED, CLOSED
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// 9. SERVICE & NOTIFICATIONS
// -------------------------------------------------------------

model ReturnRequest {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  type        String   @default("RETURN") // RETURN, REPLACEMENT, WARRANTY
  reason      String
  description String?
  images      String?  // JSON array
  status      String   @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, REJECTED, PICKUP_SCHEDULED, RESOLVED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id            String   @id @default(uuid())
  recipientType String   // CUSTOMER, ADMIN, SALES
  recipientId   String?
  channel       String   // WHATSAPP, SMS, EMAIL, IN_APP
  title         String
  message       String
  status        String   @default("SENT") // PENDING, SENT, FAILED
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
}
